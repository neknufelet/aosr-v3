{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "AbsoluteFurniture": {
      "additionalProperties": false,
      "description": "底面中心房間座標與絕對角度；0 度時寬沿房間 x、深沿房間 y。",
      "properties": {
        "furniture_id": {
          "minLength": 1,
          "quantity": "家具代號",
          "reference": "沒有基準（只是文字或狀態，不是量測值）",
          "title": "Furniture Id",
          "type": "string",
          "unit": "1",
          "validity": "不是估出來的量測值（這一格是文字、狀態、容器、表上宣告的值或計數，不是估出來的量）"
        },
        "kind": {
          "$ref": "#/$defs/FurnitureKind",
          "quantity": "家具種類",
          "reference": "沒有基準（只是文字或狀態，不是量測值）",
          "unit": "1",
          "validity": "不是估出來的量測值（這一格是文字、狀態、容器、表上宣告的值或計數，不是估出來的量）"
        },
        "material": {
          "enum": [
            "fabric",
            "leather",
            "wood",
            "glass",
            "absorptive_cloud"
          ],
          "quantity": "材質類型",
          "reference": "沒有基準（只是文字或狀態，不是量測值）",
          "title": "Material",
          "type": "string",
          "unit": "1",
          "validity": "不是估出來的量測值（這一格是文字、狀態、容器、表上宣告的值或計數，不是估出來的量）"
        },
        "width_m": {
          "exclusiveMinimum": 0.0,
          "gt": 0.0,
          "quantity": "寬度",
          "reference": "家具本地左右全長",
          "title": "Width M",
          "type": "number",
          "unit": "m",
          "validity": "可估"
        },
        "depth_m": {
          "exclusiveMinimum": 0.0,
          "gt": 0.0,
          "quantity": "深度",
          "reference": "家具本地前後全長",
          "title": "Depth M",
          "type": "number",
          "unit": "m",
          "validity": "可估"
        },
        "height_m": {
          "exclusiveMinimum": 0.0,
          "gt": 0.0,
          "quantity": "高度",
          "reference": "底面到頂面全長",
          "title": "Height M",
          "type": "number",
          "unit": "m",
          "validity": "可估"
        },
        "bottom_center_m": {
          "description": "底面中心的房間 x、y、z 座標；不是耳朵高度或家具體心",
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "quantity": "底面中心座標",
          "reference": "房間角落為原點",
          "title": "Bottom Center M",
          "type": "array",
          "unit": "m",
          "validity": "不是估出來的量測值（這一格是文字、狀態、容器、表上宣告的值或計數，不是估出來的量）"
        },
        "yaw_deg": {
          "description": "絕對直角轉向：0 度寬沿 x、深沿 y；只收 0／90／180／270",
          "enum": [
            0.0,
            90.0,
            180.0,
            270.0
          ],
          "quantity": "轉角",
          "reference": "房間 x 軸為寬度方向，繞垂直軸逆時針",
          "title": "Yaw Deg",
          "type": "number",
          "unit": "deg",
          "validity": "不是估出來的量測值（這一格是文字、狀態、容器、表上宣告的值或計數，不是估出來的量）"
        }
      },
      "required": [
        "furniture_id",
        "kind",
        "material",
        "width_m",
        "depth_m",
        "height_m",
        "bottom_center_m",
        "yaw_deg"
      ],
      "title": "AbsoluteFurniture",
      "type": "object"
    },
    "AirLayer": {
      "additionalProperties": false,
      "description": "AirLayer（空氣層）：以正厚度記錄構造內空腔。",
      "properties": {
        "kind": {
          "const": "air",
          "default": "air",
          "description": "kind（層種類代號，air 表示空氣層）",
          "title": "Kind",
          "type": "string"
        },
        "thickness_m": {
          "description": "thickness_m（空腔厚度，m）",
          "exclusiveMinimum": 0,
          "title": "Thickness M",
          "type": "number"
        }
      },
      "required": [
        "thickness_m",
        "kind"
      ],
      "title": "AirLayer",
      "type": "object"
    },
    "AnalyticAxisymmetricInput": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "analytic_axisymmetric_two_parameter_v1",
          "quantity": "聲源模型種類",
          "reference": "沒有基準（只是文字或狀態，不是量測值）",
          "title": "Kind",
          "type": "string",
          "unit": "1",
          "validity": "不是估出來的量測值（這一格是文字、狀態、容器、表上宣告的值或計數，不是估出來的量）"
        },
        "parameters": {
          "$ref": "#/$defs/SourceCurveParameters",
          "description": "六個曲線標量全部明寫，不從登記簿補預設",
          "quantity": "聲源模型參數",
          "reference": "六個曲線標量，見底下每一欄自己的單位與基準",
          "unit": "1",
          "validity": "不是估出來的量測值（這一格是文字、狀態、容器、表上宣告的值或計數，不是估出來的量）"
        },
        "aim_m": {
          "additionalProperties": false,
          "description": "聲源的共同對準點（公尺）",
          "properties": {
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            },
            "z": {
              "type": "number"
            }
          },
          "quantity": "長度",
          "reference": "房間角落為原點",
          "required": [
            "x",
            "y",
            "z"
          ],
          "type": "object",
          "unit": "m",
          "validity": "可估"
        }
      },
      "required": [
        "kind",
        "parameters",
        "aim_m"
      ],
      "title": "AnalyticAxisymmetricInput",
      "type": "object"
    },
    "Assembly": {
      "additionalProperties": false,
      "description": "Assembly（多層構造）：房間側 → 牆體側排列，明給背後負載。",
      "properties": {
        "kind": {
          "const": "assembly",
          "default": "assembly",
          "description": "kind（表面種類代號，assembly 表示多層構造）",
          "title": "Kind",
          "type": "string"
        },
        "layers": {
          "description": "layers（至少一層，依房間側到牆體側排序）",
          "items": {
            "discriminator": {
              "mapping": {
                "air": "#/$defs/AirLayer",
                "board": "#/$defs/BoardLayer",
                "porous": "#/$defs/PorousLayer"
              },
              "propertyName": "kind"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/PorousLayer"
              },
              {
                "$ref": "#/$defs/AirLayer"
              },
              {
                "$ref": "#/$defs/BoardLayer"
              }
            ]
          },
          "minItems": 1,
          "title": "Layers",
          "type": "array"
        },
        "backing": {
          "description": "backing（背後負載：rigid 是剛背，air 是空氣負載）",
          "enum": [
            "rigid",
            "air"
          ],
          "title": "Backing",
          "type": "string"
        }
      },
      "required": [
        "layers",
        "backing",
        "kind"
      ],
      "title": "Assembly",
      "type": "object"
    },
    "BoardLayer": {
      "additionalProperties": false,
      "description": "BoardLayer（薄板層）：壓力跳躍阻抗 r+jωm，沿用正時間指數慣例。",
      "properties": {
        "kind": {
          "const": "board",
          "default": "board",
          "description": "kind（層種類代號，board 表示薄板層）",
          "title": "Kind",
          "type": "string"
        },
        "surface_mass_kg_m2": {
          "description": "surface_mass_kg_m2（面密度，kg/m²）",
          "exclusiveMinimum": 0,
          "title": "Surface Mass Kg M2",
          "type": "number"
        },
        "resistance_pa_s_m": {
          "description": "resistance_pa_s_m（面阻力，Pa·s/m）",
          "minimum": 0,
          "title": "Resistance Pa S M",
          "type": "number"
        }
      },
      "required": [
        "surface_mass_kg_m2",
        "resistance_pa_s_m",
        "kind"
      ],
      "title": "BoardLayer",
      "type": "object"
    },
    "ConstantImpedance": {
      "additionalProperties": false,
      "description": "ConstantImpedance（固定實數阻抗）：整面局部反應，不能當成矩陣層。",
      "properties": {
        "kind": {
          "const": "constant_impedance",
          "default": "constant_impedance",
          "description": "kind（表面種類代號，constant_impedance 表示固定阻抗）",
          "title": "Kind",
          "type": "string"
        },
        "impedance_pa_s_m": {
          "description": "impedance_pa_s_m（阻抗，Pa·s/m；整面一個正有限實數）",
          "exclusiveMinimum": 0,
          "title": "Impedance Pa S M",
          "type": "number"
        }
      },
      "required": [
        "impedance_pa_s_m",
        "kind"
      ],
      "title": "ConstantImpedance",
      "type": "object"
    },
    "FurnitureKind": {
      "description": "家具種類；沙發／座椅貼地，其餘只表示懸空的板。",
      "enum": [
        "sofa",
        "chair",
        "coffee_table",
        "desk",
        "ceiling_cloud"
      ],
      "title": "FurnitureKind",
      "type": "string"
    },
    "LowFrequencyAxis": {
      "description": "報表低頻取樣軸；搜尋用正式細軸，驗證用 1 Hz 軸。",
      "enum": [
        "search_octave_24",
        "verification_linear_1hz"
      ],
      "title": "LowFrequencyAxis",
      "type": "string"
    },
    "MeasuredImpedance": {
      "additionalProperties": false,
      "description": "MeasuredImpedance（實測阻抗表）：表外用描述同一面牆的底構造補值。",
      "properties": {
        "kind": {
          "const": "measured_impedance",
          "default": "measured_impedance",
          "description": "kind（表面種類代號，measured_impedance 表示實測阻抗表）",
          "title": "Kind",
          "type": "string"
        },
        "points": {
          "description": "points（實測阻抗列；至少兩列，頻率嚴格遞增）",
          "items": {
            "$ref": "#/$defs/MeasuredImpedancePoint"
          },
          "minItems": 2,
          "title": "Points",
          "type": "array"
        },
        "base_assembly": {
          "$ref": "#/$defs/Assembly",
          "description": "base_assembly（同一面牆的底構造；表外模型補值，只收多層構造）"
        },
        "source_and_conditions": {
          "description": "source_and_conditions（量測出處與條件，包含阻抗管、入射方式與樣品厚度）",
          "minLength": 1,
          "title": "Source And Conditions",
          "type": "string"
        },
        "fill_rule": {
          "const": "log_linear_table_base_assembly_outside_v1",
          "default": "log_linear_table_base_assembly_outside_v1",
          "description": "fill_rule（補值規則版本：log_linear_table_base_assembly_outside_v1 表示表內對數頻率線性內插、表外底構造補值第一版）",
          "title": "Fill Rule",
          "type": "string"
        }
      },
      "required": [
        "points",
        "base_assembly",
        "source_and_conditions",
        "kind"
      ],
      "title": "MeasuredImpedance",
      "type": "object"
    },
    "MeasuredImpedancePoint": {
      "additionalProperties": false,
      "description": "MeasuredImpedancePoint（實測列）：SI 阻抗，正時間指數。",
      "properties": {
        "frequency_hz": {
          "description": "frequency_hz（量測頻率，Hz；有限正數、逐列嚴格遞增）",
          "exclusiveMinimum": 0,
          "title": "Frequency Hz",
          "type": "number"
        },
        "real_pa_s_m": {
          "description": "real_pa_s_m（阻抗實部，Pa·s/m；有限且大於零，不收正規化值）",
          "exclusiveMinimum": 0,
          "title": "Real Pa S M",
          "type": "number"
        },
        "imag_pa_s_m": {
          "description": "imag_pa_s_m（阻抗虛部，Pa·s/m；有限，時間慣例 e^{+jωt}；e^{−iωt} 的表須將虛部變號）",
          "title": "Imag Pa S M",
          "type": "number"
        }
      },
      "required": [
        "frequency_hz",
        "real_pa_s_m",
        "imag_pa_s_m"
      ],
      "title": "MeasuredImpedancePoint",
      "type": "object"
    },
    "OmnidirectionalInput": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "omnidirectional",
          "quantity": "聲源模型種類",
          "reference": "沒有基準（只是文字或狀態，不是量測值）",
          "title": "Kind",
          "type": "string",
          "unit": "1",
          "validity": "不是估出來的量測值（這一格是文字、狀態、容器、表上宣告的值或計數，不是估出來的量）"
        }
      },
      "required": [
        "kind"
      ],
      "title": "OmnidirectionalInput",
      "type": "object"
    },
    "PorousLayer": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "model": {
                "enum": [
                  "komatsu",
                  "miki"
                ]
              }
            }
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "porosity"
                  ]
                },
                {
                  "required": [
                    "tortuosity"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "model": {
                "const": "wilson_2015"
              }
            },
            "required": [
              "model"
            ]
          },
          "then": {
            "properties": {
              "porosity": {
                "not": {
                  "type": "null"
                }
              },
              "tortuosity": {
                "not": {
                  "type": "null"
                }
              }
            },
            "required": [
              "porosity",
              "tortuosity"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "model": {
                "const": "mechel_1976"
              }
            },
            "required": [
              "model"
            ]
          },
          "then": {
            "not": {
              "required": [
                "tortuosity"
              ]
            },
            "properties": {
              "porosity": {
                "maximum": 1,
                "not": {
                  "type": "null"
                }
              }
            },
            "required": [
              "porosity"
            ]
          }
        }
      ],
      "description": "PorousLayer（多孔層）：模型決定必填參數，不接受會被忽略的欄位。",
      "properties": {
        "kind": {
          "const": "porous",
          "default": "porous",
          "description": "kind（層種類代號，porous 表示多孔層）",
          "title": "Kind",
          "type": "string"
        },
        "thickness_m": {
          "description": "thickness_m（層厚度，m）",
          "exclusiveMinimum": 0,
          "title": "Thickness M",
          "type": "number"
        },
        "flow_resistivity_pa_s_m2": {
          "description": "flow_resistivity_pa_s_m2（流阻，Pa·s/m²）",
          "exclusiveMinimum": 0,
          "title": "Flow Resistivity Pa S M2",
          "type": "number"
        },
        "model": {
          "default": "komatsu",
          "description": "model（多孔模型：komatsu 為小松纖維經驗式，miki 為三木纖維經驗式，wilson_2015 為威爾森鬆弛模型，mechel_1976 為梅歇爾低頻延伸式）",
          "enum": [
            "komatsu",
            "miki",
            "wilson_2015",
            "mechel_1976"
          ],
          "title": "Model",
          "type": "string"
        },
        "material_class": {
          "description": "material_class（材料類別：fibrous 是纖維類，foam 是泡棉）",
          "enum": [
            "fibrous",
            "foam"
          ],
          "title": "Material Class",
          "type": "string"
        },
        "porosity": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "porosity（孔隙率，無量綱；模型要求時必填）",
          "title": "Porosity"
        },
        "tortuosity": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "tortuosity（曲折度，無量綱；模型要求時必填）",
          "title": "Tortuosity"
        }
      },
      "required": [
        "thickness_m",
        "flow_resistivity_pa_s_m2",
        "material_class",
        "kind"
      ],
      "title": "PorousLayer",
      "type": "object"
    },
    "SourceCurveParameters": {
      "additionalProperties": false,
      "description": "兩參數曲線的六個標量，逐欄帶四件事；值的規則只住在 :class:`TwoParameterCurve`（驗證時交給它），\n「大於 0」那條界限跟它共用同一個型別 ``PositiveStrictFloat``，匯出的 schema 才說得出同一條界限。",
      "properties": {
        "beta_limit": {
          "quantity": "指向參數 β 的高頻極限",
          "reference": "決策紙 source-directivity-two-parameter-axisymmetric-baseline 的兩參數曲線",
          "title": "Beta Limit",
          "type": "number",
          "unit": "1",
          "validity": "不是估出來的量測值（這一格是文字、狀態、容器、表上宣告的值或計數，不是估出來的量）"
        },
        "beta_corner_hz": {
          "exclusiveMinimum": 0.0,
          "quantity": "β 曲線的轉折頻率",
          "reference": "決策紙 source-directivity-two-parameter-axisymmetric-baseline 的兩參數曲線",
          "title": "Beta Corner Hz",
          "type": "number",
          "unit": "Hz",
          "validity": "不是估出來的量測值（這一格是文字、狀態、容器、表上宣告的值或計數，不是估出來的量）"
        },
        "beta_exponent": {
          "exclusiveMinimum": 0.0,
          "quantity": "β 曲線的斜率指數",
          "reference": "決策紙 source-directivity-two-parameter-axisymmetric-baseline 的兩參數曲線",
          "title": "Beta Exponent",
          "type": "number",
          "unit": "1",
          "validity": "不是估出來的量測值（這一格是文字、狀態、容器、表上宣告的值或計數，不是估出來的量）"
        },
        "power_floor_limit_db": {
          "quantity": "功率下限的高頻極限",
          "reference": "相對於正前方的聲壓平方（功率）",
          "title": "Power Floor Limit Db",
          "type": "number",
          "unit": "dB",
          "validity": "不是估出來的量測值（這一格是文字、狀態、容器、表上宣告的值或計數，不是估出來的量）"
        },
        "power_floor_corner_hz": {
          "exclusiveMinimum": 0.0,
          "quantity": "功率下限曲線的轉折頻率",
          "reference": "決策紙 source-directivity-two-parameter-axisymmetric-baseline 的兩參數曲線",
          "title": "Power Floor Corner Hz",
          "type": "number",
          "unit": "Hz",
          "validity": "不是估出來的量測值（這一格是文字、狀態、容器、表上宣告的值或計數，不是估出來的量）"
        },
        "power_floor_exponent": {
          "exclusiveMinimum": 0.0,
          "quantity": "功率下限曲線的斜率指數",
          "reference": "決策紙 source-directivity-two-parameter-axisymmetric-baseline 的兩參數曲線",
          "title": "Power Floor Exponent",
          "type": "number",
          "unit": "1",
          "validity": "不是估出來的量測值（這一格是文字、狀態、容器、表上宣告的值或計數，不是估出來的量）"
        }
      },
      "required": [
        "beta_limit",
        "beta_corner_hz",
        "beta_exponent",
        "power_floor_limit_db",
        "power_floor_corner_hz",
        "power_floor_exponent"
      ],
      "title": "SourceCurveParameters",
      "type": "object"
    },
    "WholeWallZone": {
      "additionalProperties": false,
      "description": "這一版每面恰好一區；材料直接採用既有構造型別。",
      "properties": {
        "area": {
          "const": "whole_wall",
          "description": "這一版每面只收整面一區；矩形分區是 #309 第二步",
