"""nvmath-python 1.0.0 的本票用到的介面；對照安裝包原始碼與離線實驗。"""
from typing import ClassVar

import numpy as np
from numpy.typing import NDArray
from scipy.sparse import csr_matrix

class DirectSolverMatrixType:
    SYMMETRIC: ClassVar[int]

class DirectSolverOptions:
    def __init__(self, *, sparse_system_type: int = ...) -> None: ...

class DirectSolver:
    def __init__(self, a: csr_matrix[np.complex64], b: NDArray[np.complex64], *,
                 options: DirectSolverOptions) -> None: ...
    def plan(self) -> None: ...
    def reset_operands(self, *, a: csr_matrix[np.complex64] | None = ...,
                       b: NDArray[np.complex64] | None = ...) -> None: ...
    def factorize(self) -> None: ...
    def solve(self) -> NDArray[np.complex64]: ...
    def free(self) -> None: ...
